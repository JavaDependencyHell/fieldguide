<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.demo</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>maven-substitution</artifactId>

    <!-- tag::s15-deps[] -->
    <dependencies>
        <!-- lib-a normally drags in lib-b. Pretend lib-b is
             abandoned and lib-d is its maintained drop-in
             replacement. Step 1: cut lib-b off this path. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>lib-a</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.demo</groupId>
                    <artifactId>lib-b</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Step 2: declare the replacement yourself. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>lib-d</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
    <!-- end::s15-deps[] -->

    <!-- tag::s15-guard[] -->
    <!-- Step 3 (optional): make sure lib-b never creeps back
         through some other path - see MS18. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>keep-lib-b-out</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.demo:lib-b</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- end::s15-guard[] -->

</project>
