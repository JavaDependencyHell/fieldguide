<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.demo</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>maven-reject</artifactId>

    <!-- tag::s14-deps[] -->
    <dependencies>
        <!-- lib-a:2.0.0 transitively requires lib-b:2.0.0 -
             the version we have decided must never appear. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>lib-a</artifactId>
            <version>2.0.0</version>
        </dependency>
    </dependencies>
    <!-- end::s14-deps[] -->

    <!-- tag::s14-enforcer[] -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-bad-versions</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- group:artifact:version - exactly
                                             this version, from any path -->
                                        <exclude>com.demo:lib-b:2.0.0</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- end::s14-enforcer[] -->

    <!-- tag::s14-fix[] -->
    <profiles>
        <profile>
            <!-- mvn validate -Pfixed : steer resolution to an
                 allowed version so the ban never trips. -->
            <id>fixed</id>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>com.demo</groupId>
                        <artifactId>lib-b</artifactId>
                        <version>1.0.0</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>
    <!-- end::s14-fix[] -->

</project>
